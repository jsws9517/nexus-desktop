<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron (Chromium V8) requires JIT + unsigned executable memory. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Load the (Electron-ABI, ad-hoc signed in beta) better-sqlite3 .node
         from the app bundle. Required by ad-hoc signing with hardenedRuntime;
         also keeps the Developer ID + notarized build working. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The app spawns worker/utility processes and external agent CLIs
         (git, claude, qwen, opencode) on the user's PATH. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Outbound network for LLM providers / MCP / update feeds. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- User-selected folders only (not sandboxed — this is a Developer ID app). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
