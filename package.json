{
  "name": "nexus-coder",
  "version": "1.1.5-0",
  "description": "NexusAgent - A powerful LLM Code Agent with MCP, Skills, and ACP support",
  "main": "dist/src/index.js",
  "bin": {
    "nexus": "./dist/src/cli/index.js",
    "agent": "./dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/theme.test.ts tests/btw-injection.test.ts tests/context-manager.test.ts tests/session-persistence.test.ts src/tests/**/*.test.ts",
    "test:dev": "tsx --test src/tests/**/*.test.ts"
  },
  "keywords": [
    "llm",
    "agent",
    "mcp",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "dist/src/",
    "bin/",
    "scripts",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "openai": "^6.45.0",
    "zod": "3.25.76"
  }
}
