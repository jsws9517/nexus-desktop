{
  "name": "nexus-desktop",
  "version": "0.4.2-beta.0",
  "nexusCoreVersion": "1.2.6-0",
  "nexusDesktopProtocol": 3,
  "description": "Nexus — where every agent finds home.",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "ddupws",
  "bin": {
    "nexus-desktop": "dist/launcher.js",
    "nexus": "node_modules/nexus-coder/dist/src/cli/index.js",
    "agent": "node_modules/nexus-coder/dist/src/cli/index.js"
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "sync:engines": "node scripts/sync-engines.mjs",
    "check:engines": "node scripts/sync-engines.mjs --check",
    "prestart": "node scripts/sync-core.mjs --build",
    "prebuild": "npm run sync:core",
    "pretypecheck": "npm run sync:core",
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/copy-assets.mjs",
    "build": "npm run compile",
    "start": "npm run compile && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:unit": "npm run build && node --test \"test/*.test.mjs\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "icon": "electron scripts/make-icon.cjs && electron scripts/export-preview.cjs",
    "test:chat": "node scripts/chat-test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:work": "node scripts/work-mode-test.mjs",
    "verify:restart": "node scripts/verify-core-restart.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "pack": "npm run build && npm pack",
    "prepare:electron-native": "node scripts/prepare-electron-native.mjs",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "dist:win": "npm run icon && npm run build && node scripts/prepare-electron-native.mjs && electron-builder --win nsis",
    "dist:linux": "npm run icon && npm run build && node scripts/prepare-electron-native.mjs && electron-builder --linux AppImage deb",
    "dist:mac": "npm run icon && npm run build && node scripts/prepare-electron-native.mjs && electron-builder --mac dmg zip --arm64"
  },
  "keywords": [
    "nexus",
    "llm",
    "agent",
    "desktop",
    "electron"
  ],
  "files": [
    "dist/",
    "package.json"
  ],
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.1",
    "brace-expansion": "^5.0.12",
    "electron-updater": "^6.8.9",
    "exceljs": "^3.4.0",
    "http-cache-semantics": "^4.3.0",
    "jszip": "^3.10.2",
    "nexus-coder": "1.2.6-0",
    "proxy-addr": "^2.0.8",
    "tar": "^7.5.22",
    "undici": "^8.11.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "happy-dom": "^21.0.4",
    "node-gyp": "^12.4.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.nexus.nexusagent",
    "productName": "nexus",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "node_modules/nexus-coder/dist/src/desktop/*.ps1"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "afterPack": "scripts/after-pack.mjs",
    "publish": {
      "provider": "github",
      "owner": "jsws9517",
      "repo": "nexus-desktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/build/**/*",
      "!node_modules/better-sqlite3/prebuilds/{darwin-x64,win32-arm64}.node",
      "!node_modules/onnxruntime-*/**",
      "!node_modules/@huggingface/**",
      "!node_modules/@emnapi/**",
      "!node_modules/@img/**",
      "!node_modules/sharp/**",
      "!node_modules/flatbuffers/**",
      "!node_modules/tiktoken/**",
      "!node_modules/exceljs/dist/**",
      "!node_modules/openai/src/**",
      "!node_modules/zod/src/**",
      "!node_modules/@anthropic-ai/sdk/src/**",
      "!node_modules/@larksuiteoapi/node-sdk/es/**",
      "!node_modules/vega-lite/src/**",
      "!node_modules/pngjs/coverage/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/CHANGELOG*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "syncDesktopName": true,
      "maintainer": "ddupws <herdkid@gmail.com>",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "nexus-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "scripts/entitlements.mac.plist",
      "entitlementsInherit": "scripts/entitlements.mac.plist",
      "identity": "-",
      "extendInfo": {
        "CFBundleDisplayName": "Nexus"
      }
    },
    "appImage": {
      "artifactName": "nexus-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "nexus-${version}-amd64.${ext}"
    },
    "artifactName": "nexus-Setup-${version}.${ext}",
    "nsis": {
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  },
  "desktopName": "nexus",
  "allowScripts": {
    "better-sqlite3": true,
    "electron-winstaller": true,
    "exceljs@3.10.0": true,
    "protobufjs@7.6.5": true
  },
  "overrides": {
    "exceljs": {
      "uuid": ">=11.1.1"
    }
  }
}
