{
  "name": "nexus-desktop",
  "version": "0.2.10",
  "description": "Nexus Agent Desktop - AI agent with multi-model support, MCP protocol integration, session persistence, streaming responses, and tool permissions.",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "ddupws",
  "bin": {
    "nexus-desktop": "dist/launcher.js",
    "nexus": "node_modules/nexus-coder/dist/src/cli/index.js",
    "agent": "node_modules/nexus-coder/dist/src/cli/index.js"
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "prebuild": "npm run sync:core",
    "pretypecheck": "npm run sync:core",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:unit": "npm run build && node --test \"test/*.test.mjs\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "icon": "electron scripts/make-icon.cjs && electron scripts/export-preview.cjs",
    "test:chat": "node scripts/chat-test.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "pack": "npm run build && npm pack",
    "prepare:electron-native": "node scripts/prepare-electron-native.mjs",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "dist:win": "npm run icon && npm run build && node scripts/prepare-electron-native.mjs && electron-builder --win nsis"
  },
  "keywords": [
    "nexus",
    "llm",
    "agent",
    "desktop",
    "electron"
  ],
  "files": [
    "dist/",
    "package.json"
  ],
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.9",
    "nexus-coder": "^1.1.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.nexus.nexusagent",
    "productName": "nexus",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "afterPack": "scripts/after-pack.mjs",
    "publish": {
      "provider": "github",
      "owner": "jsws9517",
      "repo": "nexus-desktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/build/**/*",
      "!node_modules/better-sqlite3/prebuilds/{darwin-x64,darwin-arm64,linux-x64,linux-arm64,linuxmusl-x64,linuxmusl-arm64,win32-arm64}.node"
    ],
    "win": {
      "icon": "build/icon.ico",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "nexus-Setup-${version}.${ext}",
    "nsis": {
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nexus",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron-winstaller": true
  }
}
