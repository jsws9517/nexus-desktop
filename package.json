{
  "name": "nexus-desktop",
  "version": "0.1.1",
  "description": "Nexus Agent Desktop - AI agent with multi-model support, MCP protocol integration, session persistence, streaming responses, and tool permissions.",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "ddupws",
  "bin": {
    "nexus-desktop": "dist/launcher.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "icon": "electron scripts/make-icon.cjs && electron scripts/export-preview.cjs",
    "test:chat": "node scripts/chat-test.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "pack": "npm run build && npm pack",
    "prepare:electron-native": "node scripts/prepare-electron-native.mjs",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "obfuscate": "node scripts/obfuscate.mjs",
    "dist:win": "npm run build && npm run obfuscate && node scripts/prepare-electron-native.mjs && electron-builder --win nsis",
    "dist:win:dev": "npm run build && node scripts/prepare-electron-native.mjs && electron-builder --win nsis"
  },
  "keywords": [
    "nexus",
    "llm",
    "agent",
    "desktop",
    "electron"
  ],
  "files": [
    "dist/",
    "package.json"
  ],
  "license": "ISC",
  "dependencies": {
    "nexus-coder": "^1.1.7",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "better-sqlite3": "^13.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^4.2.2",
    "terser": "^5.49.2",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.nexus.nexusagent",
    "productName": "nexus",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.mjs",
    "publish": {
      "provider": "github",
      "owner": "jsws9517",
      "repo": "nexus-desktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "nexus-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nexus"
    }
  }
}
