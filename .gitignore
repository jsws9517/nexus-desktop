# Build artifacts (regenerated on `npm run build`)
dist/
build/
release/
node_modules/
*.tgz

# Shadow release repo (separate checkout)
nexus-releases/

# Electron-ABI native build cache (prepare-electron-native.mjs regenerates).
# Only artifacts are ignored; .native/electron/package.json is tracked.
.native/electron/node_modules/
.native/electron/.stamp.json
.native/electron/package-lock.json
.opencode/
gen-final.mjs
verify-final.mjs

# Project .nexus/ folder (single project-level home for Nexus artifacts).
# rules/ is TRACKED (constitution). Temp/scratch lives in trash/ — NEVER committed.
.nexus/trash/
# User-level session memory NEVER belongs in a project .nexus/ (it lives in the
# global ~/.nexus/); any stray knowledge/ copies under a project must stay ignored.
.nexus/knowledge/
.nexus/memory/
